token = "";
lastsurvey = datetime(2021, 6, 1, 0, 0, 0, 0, pytz.UTC);

def get_last_survey_datetime():
    results = bigquery_client.query("SELECT MAX(SYS_SOURCE_TIMESTAMP) AS SYS_SOURCE_TIMESTAMP FROM dev01-insights.LND.LND_INMOMENT_SURVEY_RESPONSE").result();
    for row in results:
        if row.SYS_SOURCE_TIMESTAMP is None:
            return datetime(2021, 6, 1, 0, 0, 0, 0, pytz.UTC);
        else:
            return row.SYS_SOURCE_TIMESTAMP;

def get_survey_ids(fromdt, todt):
    global token;
    headers = {
        "Authorization": "OAuth " + token
    }
    response = requests.get("https://api.inmoment.com.au/api/rest/1.1/etl/surveyresponses/ids/" + fromdt.strftime('%Y-%m-%dT%H:%M:%S') + "/" + todt.strftime('%Y-%m-%dT%H:%M:%S') + "/45", headers=headers);
    surveyids = response.json();
    return surveyids;

def get_survey(survey_ids):
    global token;
    headers = {
        "Authorization": "OAuth " + token
    }
    response = requests.post("https://api.inmoment.com.au/api/rest/1.1/etl/surveyresponses/batch/true", headers=headers, json=survey_ids);
    surveydetails = response.json();
    return surveydetails;

